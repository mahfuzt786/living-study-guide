# Copy this file to .env and fill in what you need. Real environment variables
# (for example Replit Secrets) take precedence over this file.

# Claude drafts the cards when this is set. Without it, the app uses its
# offline extractor, which only turns your own sentences into cards.
ANTHROPIC_API_KEY=

# Optional overrides.
# STUDY_MODEL=claude-opus-5-5
# STUDY_EFFORT=medium           # low | medium | high | xhigh | max
# STUDY_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: a CA bundle for HTTPS calls to the Claude API. On Windows the app
# already trusts the system certificate store, which covers antivirus HTTPS
# scanning (e.g. Norton Web Shield).
# CA_BUNDLE=C:\path\to\cacert.pem

# Optional: where the SQLite database lives (default: ./data).
# STUDY_DATA_DIR=
